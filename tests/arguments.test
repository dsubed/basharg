#!/bin/bash


# Run tests
bash_arg_first_test () {

    RESULT=$(bash first.sh -t "some_value" "username_value" "password_value")
    check_last_command 0
    assert_equal "Test 1" "username_value some_value" "$RESULT"
    assert_not_equal "Test 2" "kalle" "$RESULT"
    color_block purple "$RESULT"
}



